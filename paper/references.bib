	urldate = {2026-01-23},
	date = {2024-05},
	note = {{ISSN}: 2473-3490},
	keywords = {Genomics, pangenomics, Data integration, Data engineering, Data visualization, graph databases, graph queries, Metadata, Pipelines, Scalability},
	file = {Full Text PDF:D\:\\Bibliography\\storage\\A7QNKP6U\\Arnoux et al. - 2024 - Integrating Complex Pangenome Graphs.pdf:application/pdf},
